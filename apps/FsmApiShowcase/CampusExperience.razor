@media(max-width:640px){.hud-top{padding:12px;grid-template-columns:1fr auto}.school-mark{display:none}.walk-readout{top:63px;left:13px;font-size:.58rem}.exit{font-size:.68rem}.world-clock{font-size:.7rem}.controls-hint{bottom:14px;font-size:.52rem;gap:4px}.nearby{bottom:54px;min-width:0;width:min(300px,calc(100% - 25px))}.arrival-panel{padding:25px 20px 20px}.map-card,.course-door{padding:19px}.map-courses{grid-template-columns:1fr 1fr}.campus-toast{top:64px;font-size:.67rem}}
@media(prefers-reduced-motion:reduce){.campus-world *{scroll-behavior:auto!important;transition:none!important;animation:none!important}}

@code {
    private const string SessionKey = "tsw.fsm-userio.trace.v1";
    private readonly SvgVisualizerBackend _svgBackend = new(_ => { }, 1280, 720, "#23333a");
    private readonly VisualizerResourceCatalog _resources = new();
    private readonly List<FaceTriangle> _triangles = [];
    private readonly List<Building> _buildings = [];
    private readonly HashSet<string> _enrolled = new(StringComparer.Ordinal);
    private DotNetObjectReference<CampusExperience>? _self;
    private string _sceneSvg = "";
    private string _nearbyLabel = "";
    private string _ambientLine = "WORKSHOPS OPEN";
    private string _toast = "";
    private string _campusClock = "09:18";
    private Building? _selectedBuilding;
    private bool _started;
    private bool _mapOpen;
    private float _playerX;
    private float _playerZ = 17f;
    private float _yaw;
    private DateTime _nextAmbient = DateTime.UtcNow;
    private DateTime _lastMove = DateTime.UtcNow;

    private static readonly Dictionary<string, string> CourseIds = new(StringComparer.Ordinal)
    {
        ["fsm-bench"] = "fsm-userio",
        ["npc-studio"] = "debug",
        ["acoustic-studio-lab"] = "physics",
        ["image-tools"] = "visualize",
        ["blueprint-library"] = "composition",
        ["singularity-lab"] = "education",
        ["singularity-ontology-mall"] = "composition"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        try
        {
            var json = await JS.InvokeAsync<string>("learningCampusInput.fetchCatalog");
            LoadCatalog(json);
            RenderScene();
            await JS.InvokeVoidAsync("learningCampusInput.attach", _self);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _toast = "Campus scene could not load: " + ex.Message;
            StateHasChanged();
        }
    }

    private void LoadCatalog(string json)
    {
        using var document = JsonDocument.Parse(json);
        foreach (var item in document.RootElement.EnumerateArray())
        {
            var id = item.GetProperty("Id").GetString() ?? "";
            var name = item.GetProperty("Name").GetString() ?? id;
            var x = item.GetProperty("X").GetDouble();
            var y = item.GetProperty("Y").GetDouble();
            var width = item.GetProperty("Width").GetDouble();
            var height = item.GetProperty("Height").GetDouble();
            var accent = item.GetProperty("Accent").GetString() ?? "#ffd277";
            var fill = item.GetProperty("Fill").GetString() ?? "#46534c";
            var centerX = (float)((x + width / 2 - 50) * 0.31);
            var centerZ = (float)((y + height / 2 - 50) * 0.42);
            var depth = Math.Clamp((float)(height * 0.42), 2.7f, 7.8f);
            var span = Math.Clamp((float)(width * 0.31), 2.7f, 8.5f);
            var tall = id.Contains("mansion", StringComparison.Ordinal) || id.Contains("capitol", StringComparison.Ordinal) ? 8.2f : id.Contains("mall", StringComparison.Ordinal) ? 6.5f : 4.5f;
            _buildings.Add(new Building(id, name, centerX, centerZ, span, depth, tall, accent, fill));
        }
        BuildWorldMesh();
    }

    private void BuildWorldMesh()
    {
        _triangles.Clear();
        for (var x = -36; x < 36; x += 6)
            for (var z = -42; z < 34; z += 6)
            {
                var color = ((x / 6 + z / 6) & 1) == 0 ? "#414c41" : "#465044";
                AddQuad(new(x, 0.012f, z), new(x + 5.7f, 0.012f, z), new(x + 5.7f, 0.012f, z + 5.7f), new(x, 0.012f, z + 5.7f), color);
            }
        AddQuad(new(-2.2f, .025f, 31), new(2.2f, .025f, 31), new(2.2f, .025f, -42), new(-2.2f, .025f, -42), "#9b8965");
        for (var z = -33; z <= 18; z += 9)
            AddQuad(new(-18, .03f, z - .45f), new(18, .03f, z - .45f), new(18, .03f, z + .45f), new(-18, .03f, z + .45f), "#827c61");

        // A block-built entry arch, paths, lanterns, grove, and central gathering plaza.
        AddBox(-4.2f, 0, 5.2f, 1.4f, 5.8f, 1.4f, "#57685d", "#9be4ae");
        AddBox(2.8f, 0, 5.2f, 1.4f, 5.8f, 1.4f, "#57685d", "#9be4ae");
        AddBox(-2.8f, 4.6f, 5.2f, 5.6f, 1.2f, 1.4f, "#465b54", "#f3d582");
        AddBox(-1.1f, .05f, -8f, 2.2f, .5f, 2.2f, "#79816c", "#f3d582");
        AddBox(-.75f, .55f, -8f, 1.5f, .35f, 1.5f, "#75bed0", "#e8cd82");
        for (var i = 0; i < 12; i++)
        {
            var side = i % 2 == 0 ? -1 : 1;
            var z = -38 + i / 2 * 6.5f;
            var x = side * (8f + (i % 3) * 2.4f);
            AddBox(x - .18f, 0, z - .18f, .36f, 2.2f, .36f, "#62513a", "#ffd277");
            AddBox(x - .34f, 2.1f, z - .34f, .68f, .4f, .68f, "#f3bc61", "#fff0b8");
        }
        for (var i = 0; i < 18; i++)
        {
            var side = i % 2 == 0 ? -1 : 1;
            var z = -38 + i / 2 * 4.5f + (i % 3) * 1.4f;
            var x = side * (11f + (i % 4) * 2.1f);
            AddTree(x, z, "#39724c", "#64a65a");
        }

        foreach (var b in _buildings)
        {
            AddBox(b.X - b.Width / 2, 0.05f, b.Z - b.Depth / 2, b.Width, b.Height, b.Depth, b.Fill, b.Accent);
            AddBox(b.X - b.Width / 2 - .18f, b.Height - .05f, b.Z - b.Depth / 2 - .18f, b.Width + .36f, .42f, b.Depth + .36f, "#38433f", b.Accent);
            var doorZ = b.Z + b.Depth / 2 + .055f;
            AddBox(b.X - .52f, .05f, doorZ, 1.04f, 2.05f, .12f, "#1b292b", "#e6c778");
            for (var window = -1; window <= 1; window++)
                AddBox(b.X + window * Math.Min(1.3f, b.Width * .23f) - .2f, 2.55f, doorZ, .4f, .68f, .1f, "#92bec0", "#f4d68a");
        }
    }

    private void AddTree(float x, float z, string trunk, string leaves)
    {
        AddBox(x - .25f, .02f, z - .25f, .5f, 2.6f, .5f, trunk, "#a58654");
        AddBox(x - 1.15f, 2.1f, z - 1.15f, 2.3f, 2.2f, 2.3f, leaves, "#8dc872");
        AddBox(x - .72f, 3.6f, z - .72f, 1.44f, 1.5f, 1.44f, "#559b5a", "#b0db75");
    }

    private void AddBox(float x, float y, float z, float sx, float sy, float sz, string body, string accent)
    {
        var a = new Vector3(x, y, z); var b = new Vector3(x + sx, y, z); var c = new Vector3(x + sx, y + sy, z); var d = new Vector3(x, y + sy, z);
        var e = new Vector3(x, y, z + sz); var f = new Vector3(x + sx, y, z + sz); var g = new Vector3(x + sx, y + sy, z + sz); var h = new Vector3(x, y + sy, z + sz);
        AddQuad(a, b, c, d, Shade(body, 1.12f)); AddQuad(f, e, h, g, Shade(body, .72f));
        AddQuad(e, a, d, h, body); AddQuad(b, f, g, c, Shade(body, .84f));
        AddQuad(d, c, g, h, accent); AddQuad(e, f, b, a, Shade(body, .68f));
    }

    private void AddQuad(Vector3 a, Vector3 b, Vector3 c, Vector3 d, string color)
    {
        AddTriangle(a, b, c, color); AddTriangle(a, c, d, color);
    }
    private void AddTriangle(Vector3 a, Vector3 b, Vector3 c, string color) =>
        _triangles.Add(new FaceTriangle(a, b, c, NormalizeHex(color)));

    private void RenderScene()
    {
        var all = new List<FaceTriangle>(_triangles.Count + 120);
        all.AddRange(_triangles);
        AddStudents(all, (float)(DateTime.UtcNow - DateTime.UnixEpoch).TotalSeconds);
        var camera = new Vector3(_playerX, 1.68f, _playerZ);
        var forward = new Vector3(MathF.Sin(_yaw), 0, -MathF.Cos(_yaw));
        var view = Matrix4x4.CreateLookAt(camera, camera + forward, Vector3.UnitY);
        var projection = Matrix4x4.CreatePerspectiveFieldOfView(MathF.PI / 3f, 16f / 9f, .12f, 100f);
        var visible = all.Select((triangle, index) =>
        {
            var center = (triangle.A + triangle.B + triangle.C) / 3f;
            var depth = Vector3.Transform(center, view).Z;
            return (Triangle: triangle, Index: index, Depth: depth);
        }).Where(item => item.Depth < -.12f).OrderBy(item => item.Depth).ToArray();
        var vertices = new List<VisualizerVertex>(visible.Length * 3);
        var indices = new List<uint>(visible.Length * 3);
        var commands = new List<VisualizerDrawCommand>(visible.Length);
        for (var i = 0; i < visible.Length; i++)
        {
            var tri = visible[i].Triangle;
            var colorId = MaterialId(tri.Color);
            var first = vertices.Count;
            vertices.Add(Vertex(tri.A)); vertices.Add(Vertex(tri.B)); vertices.Add(Vertex(tri.C));
            indices.Add((uint)first); indices.Add((uint)(first + 1)); indices.Add((uint)(first + 2));
            commands.Add(new VisualizerDrawCommand(new VisualizerResourceId(1), colorId, Matrix4x4.Identity, 3, i * 3, 0, VisualizerRepresentation.Near));
        }
        _resources.SetGeometry(new VisualizerResourceId(1), new VisualizerGeometry(1, vertices, indices));
        var frame = new VisualizerFrame(new VisualizerView(camera, view, projection), commands);
        _sceneSvg = _svgBackend.BuildSvg(frame, _resources);
        _campusClock = DateTime.Now.ToString("HH:mm", CultureInfo.InvariantCulture);
        UpdateNearby();
    }

    private void AddStudents(List<FaceTriangle> scene, float time)
    {
        for (var i = 0; i < 7; i++)
        {
            var angle = time * (.12f + i * .008f) + i * 1.7f;
            var x = MathF.Sin(angle) * (3.2f + (i % 3) * 1.1f);
            var z = -7f + MathF.Cos(angle * .7f) * (2.4f + (i % 2));
            var color = new[] { "#d99465", "#76b6c1", "#99c47a", "#b7a0d2" }[i % 4];
            AddBoxTo(scene, x - .22f, .05f, z - .18f, .44f, 1.15f, .36f, color, "#d8bc8b");
            AddBoxTo(scene, x - .18f, 1.2f, z - .16f, .36f, .38f, .32f, "#dfc59a", "#fff0c7");
        }
    }

    private void AddBoxTo(List<FaceTriangle> target, float x, float y, float z, float sx, float sy, float sz, string body, string accent)
    {
        var before = _triangles.Count;
        AddBox(x, y, z, sx, sy, sz, body, accent);
        target.AddRange(_triangles.Skip(before));
        _triangles.RemoveRange(before, _triangles.Count - before);
    }

    private void UpdateNearby()
    {
        var nearby = _buildings
            .Where(item => !string.IsNullOrWhiteSpace(CourseFor(item.Id)))
            .Select(item => (Building: item, Distance: Vector2.Distance(new Vector2(_playerX, _playerZ), new Vector2(item.X, item.Z + item.Depth / 2 + 2))))
            .Where(item => item.Distance < 7f)
            .OrderBy(item => item.Distance)
            .FirstOrDefault();
        _nearbyLabel = nearby.Building is null ? "" : nearby.Building.Name;
    }

    private static string CourseFor(string id) => CourseIds.TryGetValue(id, out var course) ? course : "";
    private static CourseInfo CourseDetails(string? id) => id switch
    {
        "fsm-userio" => new("🧭", "Make a click mean something", "Give a player choice meaning, carry it across a boundary, and let policy decide what the system can do.", "Turn an interaction into a semantic intent, then watch FSM_API govern a living behavior.", "https://github.com/TrentBest/TheSingularityWorkshop.Learning/blob/main/docs/PROBLEM_TO_PROOF.md"),

    private void Begin()
    {
        _started = true;
        RecordIntent(new SemanticIntent("Campus.Arrival.Begin"));
        _toast = "Welcome to Singularity University. The quad is open.";
        RenderScene();
    }

    private async Task FocusWorld()
    {
        if (_started) await JS.InvokeVoidAsync("learningCampusInput.lockPointer");
    }

    [JSInvokable]
    public async Task OnCampusFrame(float forward, float strafe, float look)
    {
        if (!_started || _mapOpen || _selectedBuilding is not null) return;
        _yaw += look * .0026f;
        var direction = new Vector2(MathF.Sin(_yaw), -MathF.Cos(_yaw));
        var side = new Vector2(MathF.Cos(_yaw), MathF.Sin(_yaw));
        var move = direction * forward + side * strafe;
        if (move.LengthSquared() > 1)
            move = Vector2.Normalize(move);
        var step = move * .38f;
        var nextX = _playerX + step.X;
        var nextZ = _playerZ + step.Y;
        if (!_buildings.Any(item => Math.Abs(nextX - item.X) < item.Width / 2 + .55f && Math.Abs(nextZ - item.Z) < item.Depth / 2 + .55f))
        {
            _playerX = nextX;
            _playerZ = nextZ;
        }
        var now = DateTime.UtcNow;
        if (now >= _nextAmbient)
        {
            var pulses = new[] { "STUDY GROUP · BLUEPRINT LIBRARY", "STUDIO OPEN · FSM WORKBENCH", "CLASS IN SESSION · ACOUSTIC LAB", "SHUTTLE ARRIVAL · UNIVERSITY QUARTER", "MENTOR CIRCLE · SINGULARITY LAB" };
            _ambientLine = pulses[(int)(now.TimeOfDay.TotalSeconds / 5) % pulses.Length];
            _nextAmbient = now.AddSeconds(5);
        }
        if (now - _lastMove < TimeSpan.FromMilliseconds(62) && Math.Abs(look) < .01f && move.LengthSquared() < .01f)
            return;
        _lastMove = now;
        RenderScene();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnCampusKey(string key)
    {
        if (key == "m")
        {
            _mapOpen = !_mapOpen;
            RecordIntent(new SemanticIntent(_mapOpen ? "Campus.Map.Open" : "Campus.Map.Close"));
        }
        else if (key == "e")
        {
            var building = FindNearbyBuilding();
            if (building is not null)
            {
                _selectedBuilding = building;
                RecordIntent(new SemanticIntent("Campus.Place.Inspect." + building.Id));
            }
            else
            {
                _toast = "Keep walking: look for a lit learning-space entrance.";
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    private Building? FindNearbyBuilding() =>
        _buildings.Where(item => !string.IsNullOrWhiteSpace(CourseFor(item.Id)))
            .Select(item => (Building: item, Distance: Vector2.Distance(new Vector2(_playerX, _playerZ), new Vector2(item.X, item.Z + item.Depth / 2 + 2))))
            .Where(item => item.Distance < 7f)
            .OrderBy(item => item.Distance).Select(item => item.Building).FirstOrDefault();

    private void Enroll(string courseId)
    {
        var intent = new SemanticIntent("Course.Enroll." + courseId);
        if (!AcceptIntent(intent))
        {
            _toast = "That course is not available in this campus catalog.";
            return;
        }
        _enrolled.Add(courseId);
        RecordIntent(intent);
        _toast = "Course added to your learning day.";
    }

    private bool AcceptIntent(SemanticIntent intent) =>
        intent.Name.StartsWith("Campus.", StringComparison.Ordinal) ||
        (intent.Name.StartsWith("Course.Enroll.", StringComparison.Ordinal) &&
         new[] { "fsm-userio", "visualize", "composition", "physics", "education", "debug" }.Contains(intent.Name["Course.Enroll.".Length..], StringComparer.Ordinal));

    private void RecordIntent(SemanticIntent intent)
    {
        _ = JS.InvokeVoidAsync("learningUserIo.recordIntent", intent.Name);
    }

    private void ToggleMap()
    {
        _mapOpen = !_mapOpen;
        RecordIntent(new SemanticIntent(_mapOpen ? "Campus.Map.Open" : "Campus.Map.Close"));
    }

    private void WalkTo(string buildingId)
    {
        var building = _buildings.FirstOrDefault(item => item.Id == buildingId);
        if (building is null) return;
        var doorZ = building.Z + building.Depth / 2 + 4.5f;
        var dx = _playerX - building.X;
        var dz = _playerZ - doorZ;
        _yaw = MathF.Atan2(-dx, dz);
        _playerX = building.X;
        _playerZ = doorZ;
        _mapOpen = false;
        RecordIntent(new SemanticIntent("Campus.Transit.To." + building.Id));
        RenderScene();
    }

    private void EnterLab() => JS.InvokeVoidAsync("learningCampusInput.openLab");
    private void CloseBuilding() => _selectedBuilding = null;

    private static VisualizerVertex Vertex(Vector3 point) =>
        new(point, Vector3.UnitZ, Vector2.Zero, Vector4.One);

    private VisualizerResourceId MaterialId(string hex)
    {
        var key = NormalizeHex(hex);
        var id = new VisualizerResourceId(100UL + (uint)StringComparer.Ordinal.GetHashCode(key));
        if (!_resources.TryGetMaterial(id, out _))
            _resources.SetMaterial(id, new VisualizerMaterial(1, LinearColor(key)));
        return id;
    }

    private static Vector4 LinearColor(string hex)
    {
        float Channel(int start)
        {
            var s = Convert.ToInt32(hex.Substring(start, 2), 16) / 255f;
            return s <= .04045f ? s / 12.92f : MathF.Pow((s + .055f) / 1.055f, 2.4f);
        }
        return new Vector4(Channel(1), Channel(3), Channel(5), 1);
    }

    private static string NormalizeHex(string color) => color.Length == 7 && color[0] == '#' ? color.ToUpperInvariant() : "#FFD277";
    private static string Shade(string hex, float amount)
    {
        var clean = NormalizeHex(hex);
        var channels = new[] { 1, 3, 5 }.Select(i => Math.Clamp((int)(Convert.ToInt32(clean.Substring(i, 2), 16) * amount), 0, 255));
        return "#" + string.Concat(channels.Select(value => value.ToString("X2", CultureInfo.InvariantCulture)));
    }

    public ValueTask DisposeAsync()
    {
        _self?.Dispose();
        return _svgBackend.DisposeAsync();
    }


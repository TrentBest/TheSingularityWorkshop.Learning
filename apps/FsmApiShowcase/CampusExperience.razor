@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="campus-world" tabindex="0" @onclick="FocusWorld" aria-label="First-person Singularity University campus. Use W A S D to walk, mouse to look, E to inspect a learning space, M for a map.">
    <div class="render-surface">@((MarkupString)_sceneSvg)</div>
    <div class="scene-grade"></div>
    <header class="hud-top">
        <a href="../" class="exit">← Leave campus</a>
        <div class="school-mark"><span class="crest">SU</span><span>SINGULARITY UNIVERSITY<small>UNIVERSITY QUARTER · SINGULARITY CITY</small></span></div>
        <div class="hud-right"><span class="world-clock">@_campusClock</span><button class="hud-button" @onclick:stopPropagation="true" @onclick="ToggleMap">M · MAP</button></div>
    </header>
    <div class="crosshair" aria-hidden="true"><i></i><b></b></div>
    <div class="walk-readout"><span class="live-dot"></span> CAMPUS ACTIVE <span class="readout-divider">/</span> @_ambientLine</div>
    @if (!string.IsNullOrWhiteSpace(_nearbyLabel))
    {
        <div class="nearby"><span class="nearby-key">E</span><span><b>@_nearbyLabel</b><small>Press E to explore this learning space</small></span></div>
    }
    <div class="controls-hint"><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> WALK <span>·</span> MOUSE LOOK <span>·</span> <kbd>E</kbd> INTERACT <span>·</span> <kbd>M</kbd> CAMPUS MAP</div>

    @if (!_started)
    {
        <div class="arrival-panel" @onclick:stopPropagation="true">
            <div class="arrival-eyebrow">SINGULARITY CITY · UNIVERSITY QUARTER</div>
            <h1>Step inside.</h1>
            <p>Walk the quad. Follow the sound of activity. Find a workshop that catches your eye.</p>
            <button class="enter-button" @onclick="Begin">Enter the campus <span>↗</span></button>
            <div class="arrival-note">FIRST-PERSON WALK · VISUALIZE PERSPECTIVE FRAMES · NO INSTALL</div>
        </div>
    }

    @if (_mapOpen)
    {
        <div class="map-overlay" @onclick="ToggleMap">
            <div class="map-card" @onclick:stopPropagation="true">
                <button class="close-map" @onclick="ToggleMap" aria-label="Close campus map">×</button>
                <div class="map-kicker">YOU ARE HERE · UNIVERSITY QUARTER</div>
                <h2>Find your next workshop.</h2>
                <img src="../data/campus-map.svg" alt="Block-built University campus map generated by Visualize from WebPage's campus catalog" />
                <p>Map generated from WebPage's <code>SingularityCampusCatalog</code>. Close it, pick a direction, and walk there.</p>
                <div class="map-courses">
                    @foreach (var building in _buildings.Where(item => !string.IsNullOrWhiteSpace(CourseFor(item.Id))))
                    {
                        <button @onclick="() => WalkTo(building.Id)">@building.Name <span>→</span></button>
                    }
                </div>
            </div>
        </div>
    }

    @if (_selectedBuilding is not null)
    {
        var courseId = CourseFor(_selectedBuilding.Id);
        var course = CourseDetails(courseId);
        <div class="course-overlay" @onclick="CloseBuilding">
            <article class="course-door" @onclick:stopPropagation="true">
                <button class="close-door" @onclick="CloseBuilding" aria-label="Close learning space">×</button>
                <div class="door-kicker">YOU FOUND · @_selectedBuilding.Name.ToUpperInvariant()</div>
                <div class="door-icon">@course.Icon</div>
                <h2>@course.Title</h2>
                <p>@course.Summary</p>
                <div class="course-goal"><span>THE CHALLENGE</span><strong>@course.Goal</strong></div>
                @if (!string.IsNullOrWhiteSpace(courseId) && _enrolled.Contains(courseId))
                {
                    <div class="enrolled-note">✓ Added to your learning day</div>
                }
                else
                {
                    <button class="enroll-button" @onclick="() => Enroll(courseId)">Join this course <span>↗</span></button>
                }
                <a class="source-link" href="@course.Source" target="_blank" rel="noreferrer">Continue into the guided source material ↗</a>
                @if (courseId == "fsm-userio")
                {
                    <button class="lab-button" @onclick="EnterLab">Enter the live FSM_API lab</button>
                }
                <small class="session-note">Session enrollment is held in this browser tab.</small>
            </article>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_toast))
    {
        <div class="campus-toast" role="status">@_toast</div>
    }
</div>

<style>
